{
  "name": "robz-dpi",
  "productName": "Robz DPI",
  "version": "0.6.0",
  "private": true,
  "description": "Yalnız seçtiğiniz sitelerde çalışan, Windows için açık kaynak DPI aracı.",
  "license": "MIT",
  "homepage": "https://github.com/kutsalkiremitci/robz-dpi",
  "repository": {
    "type": "git",
    "url": "https://github.com/kutsalkiremitci/robz-dpi.git"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.js && node scripts/fetch-engine.mjs --optional",
    "engine": "node scripts/fetch-engine.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test \"test/*.test.mjs\" && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "tauri icon assets/logo.svg -o src-tauri/icons && node -e \"require('fs').rmSync('src-tauri/icons/icon.icns',{force:true})\"",
    "screenshots": "node scripts/screenshots.mjs",
    "banners": "node scripts/render-banners.mjs",
    "site": "node site/build.mjs",
    "build:linux": "cargo build --release --manifest-path src-tauri/engine-bin/Cargo.toml && tauri build",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/portable.ps1 -Version %npm_package_version%"
  },
  "devDependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@tauri-apps/cli": "^2.12.6",
    "htm": "^3.1.1"
  }
}
