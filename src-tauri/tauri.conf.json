{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robz DPI",
  "mainBinaryName": "RobzDPI",
  "version": "0.6.0",
  "identifier": "com.robz.dpi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Robz",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Eğitim ve test amaçlı açık kaynak DPI aracı",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/WinDivert.dll": "engine/WinDivert.dll",
      "engine/WinDivert64.sys": "engine/WinDivert64.sys",
      "engine/licenses/": "engine/licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
